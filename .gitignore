# huma-nirvana-adapter .gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.bin
bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# env file
.env
.env.*

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Specs (local only, do not commit)
specs/
.cursor/
.specify

# Private planning and agent instructions live in ../my-specs.
/specs
/.specify
/AGENTS.md
/CLAUDE.md
/.claude/settings.local.json
/.agents/skills/speckit-*
/.claude/skills/speckit-*
